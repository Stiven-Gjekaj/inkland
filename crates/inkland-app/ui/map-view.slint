// The map view: the rendered page and the marks of the tools.
// Rust does the pan, the zoom, and the hit test.

import { AppState, Actions, Tool } from "globals.slint";

export component MapView inherits Rectangle {
    background: #8a8f94;
    clip: true;

    changed width => { Actions.viewport-changed(self.width, self.height); }
    changed height => { Actions.viewport-changed(self.width, self.height); }
    init => { Actions.viewport-changed(self.width, self.height); }

    if AppState.has-map: Image {
        x: AppState.img-x;
        y: AppState.img-y;
        width: AppState.img-w;
        height: AppState.img-h;
        source: AppState.map-image;
        image-fit: fill;
    }

    for pin in AppState.pins: Rectangle {
        x: pin.x - 7px;
        y: pin.y - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: pin.id == AppState.selected-id ? 3px : 2px;
        border-color: pin.id == AppState.selected-id ? #d03020 : #2060c0;
    }

    if AppState.dragging-pin: Rectangle {
        x: AppState.drag-x - 7px;
        y: AppState.drag-y - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 2px;
        border-color: #d03020;
        background: #d0302060;
    }

    if AppState.tool == Tool.brush && AppState.pointer-in-map: Rectangle {
        x: AppState.pointer-x - AppState.brush-view-radius;
        y: AppState.pointer-y - AppState.brush-view-radius;
        width: AppState.brush-view-radius * 2;
        height: AppState.brush-view-radius * 2;
        border-radius: AppState.brush-view-radius;
        border-width: 1.5px;
        border-color: AppState.brush-raise ? #c05010 : #1050c0;
    }

    if AppState.generating: Rectangle {
        x: 8px;
        y: 8px;
        width: busy.preferred-width + 16px;
        height: busy.preferred-height + 8px;
        border-radius: 4px;
        background: #000000a0;
        busy := Text {
            text: "Generating...";
            color: white;
        }
    }

    TouchArea {
        mouse-cursor: AppState.tool == Tool.select ? MouseCursor.default : MouseCursor.crosshair;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                Actions.pointer-down(self.mouse-x, self.mouse-y,
                    ev.button == PointerEventButton.middle || ev.button == PointerEventButton.right);
            } else if ev.kind == PointerEventKind.up {
                Actions.pointer-up(self.mouse-x, self.mouse-y);
            }
        }
        changed mouse-x => { Actions.pointer-move(self.mouse-x, self.mouse-y); }
        changed mouse-y => { Actions.pointer-move(self.mouse-x, self.mouse-y); }
        changed has-hover => {
            if !self.has-hover { Actions.pointer-exit(); }
        }
        scroll-event(ev) => {
            Actions.scroll(self.mouse-x, self.mouse-y, ev.delta-y);
            accept
        }
    }
}
