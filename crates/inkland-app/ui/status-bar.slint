// The status bar at the bottom of the map: the pointer position in config
// units, the facts of the cell under the pointer, and the last message.

import { Theme } from "theme.slint";
import { AppState } from "globals.slint";

export component StatusBar inherits Rectangle {
    height: 22px;
    background: #fafafae0;
    Rectangle { height: 1px; y: 0; background: Theme.border; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 14px;
        Text {
            text: AppState.status-position;
            vertical-alignment: center;
            font-family: Theme.mono;
            font-size: Theme.font-size - 1px;
            color: #202020;
            min-width: 190px;
        }
        Text {
            text: AppState.status-cell;
            vertical-alignment: center;
            font-family: Theme.sans;
            font-size: Theme.font-size - 1px;
            color: #202020;
            horizontal-stretch: 2;
            overflow: elide;
        }
        Text {
            text: AppState.message;
            vertical-alignment: center;
            horizontal-alignment: right;
            font-family: Theme.sans;
            font-size: Theme.font-size - 1px;
            horizontal-stretch: 1;
            overflow: elide;
            color: AppState.message-is-error ? #b01010 : #404040;
        }
    }
}
