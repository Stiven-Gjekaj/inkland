// The Economy Overview of FMG for the selected state: the economy type,
// the people, the product, the wealth, the prosperity, the revenue, the
// expenses, and the trade. The fields set the taxes, the market fee, and
// the military budget of the state (`world.finance`).

import { Theme, Field, Label, Select, FormRow, Table, Tip } from "../theme.slint";
import { Dialog } from "../dialog.slint";
import { AppState, Actions, Lists } from "../globals.slint";

export component EconomyDialog inherits Dialog {
    id: "economy";
    title: "Economy Overview";
    content-width: 560px;
    pos-x: 440px;
    pos-y: 50px;
    FormRow {
        label: "Economy of";
        label-width: 90px;
        Select {
            dialog: true;
            horizontal-stretch: 1;
            model: Lists.state-names;
            current-index <=> AppState.overview-state;
            selected(i) => { Actions.selection-changed(); }
        }
    }
    Table {
        header: ["Figure", "Value"];
        widths: [190px, 330px];
        rows: Lists.economy-lines;
        list-height: 300px;
    }
    for f in [
        { key: "sales_tax", label: "Sales tax (share)" },
        { key: "poll_tax", label: "Poll tax a day" },
        { key: "market_fee", label: "Market fee a day" },
        { key: "military", label: "Military budget %" },
        { key: "tariffs", label: "Tariff (share or embargo)" },
    ]: FormRow {
        label: f.label;
        label-width: 150px;
        Field {
            dialog: true;
            horizontal-stretch: 1;
            placeholder: "New value, then Enter";
            accepted(t) => {
                if t != "" {
                    Actions.edit-item("finance", AppState.overview-state, f.key, t);
                    self.text = "";
                }
            }
        }
    }
    Tip {
        dialog: true;
        text: "The figures are of one day of the economy run. Prices are in the money of FMG.";
    }
}
