// The Zones Editor of FMG: the zones of the shown world, with the
// description, the type, the cells, the area, the people, and the hatch
// pattern of the fill. Remove and Draw put a zone change into
// `world.zones`.

import { Theme, Label, Table, Tip } from "../theme.slint";
import { Dialog } from "../dialog.slint";
import { DrawRow } from "../draw-row.slint";
import { Lists, Actions } from "../globals.slint";

export component ZonesDialog inherits Dialog {
    id: "zones";
    title: "Zones Editor";
    content-width: 560px;
    pos-x: 440px;
    pos-y: 80px;
    Table {
        header: ["Description", "Type", "Cells", "Area", "Population", "Fill"];
        widths: [120px, 90px, 44px, 70px, 70px, 50px];
        rows: Lists.zones;
        action: "Remove";
        act(id) => { Actions.edit-item("zones", id, "remove", ""); }
        list-height: 240px;
    }
    DrawRow {
        label: "New zone";
        tool: "add-zone";
        line: true;
        placeholder: "Name; type, for example Disease";
    }
    Tip {
        dialog: true;
        text: "Zones: " + Lists.zones.length + ". The world makes the zones after the markers. Draw a zone: click its outline, then double-click or press Enter.";
    }
}
