// The States, Cultures, Religions, and Provinces editors. They show the
// names and the numbers of the shown world. They do not edit, because the
// config has no fields for these items yet.

import { Theme, Table, TableRow, Tip } from "../theme.slint";
import { Dialog } from "../dialog.slint";

export component SocietyDialog inherits Dialog {
    in property <[string]> header;
    in property <[length]> widths;
    in property <[TableRow]> rows;
    content-width: 470px;
    pos-x: 460px;
    Table {
        header: root.header;
        widths: root.widths;
        rows: root.rows;
        list-height: 220px;
    }
    Tip {
        dialog: true;
        text: "The world makes these items from the generation options. The numbers count the cells and the burgs of each item.";
    }
}
