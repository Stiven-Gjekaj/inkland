// The Heightmap editor: the brush that raises or lowers the land.

import { Theme, Label, Slider, Check, FormRow, Tip, Select, Table, Heading } from "../theme.slint";
import { Dialog } from "../dialog.slint";
import { AppState, Actions, Tool, Opts, Lists } from "../globals.slint";

export component HeightmapDialog inherits Dialog {
    id: "heightmap";
    title: "Heightmap Editor";
    content-width: 360px;
    pos-x: 400px;
    pos-y: 40px;
    FormRow {
        label: "Template";
        Select {
            dialog: true;
            horizontal-stretch: 1;
            model: Opts.templates;
            current-index <=> Opts.template;
            placeholder: "Custom steps";
            selected(i) => { Actions.choose("template", i); }
        }
    }
    FormRow {
        label: "Sea level";
        sea := Slider {
            dialog: true;
            minimum: 1;
            maximum: 99;
            value: Opts.sea-level.to-float();
            released(v) => { Actions.set-option("sea-level", v); }
        }
        Label { dialog: true; width: 50px; text: Math.round(sea.shown); }
    }
    FormRow {
        label: "Brush";
        Check {
            text: "Use the brush on the map";
            dialog: true;
            checked: AppState.tool == Tool.brush;
            toggled(on) => { AppState.tool = on ? Tool.brush : Tool.select; }
        }
    }
    FormRow {
        label: "Radius";
        Slider {
            dialog: true;
            minimum: 1;
            maximum: AppState.brush-radius-max;
            value: AppState.brush-radius;
            changed(v) => {
                AppState.brush-radius = v;
                Actions.brush-changed();
            }
        }
        Label { dialog: true; width: 50px; text: Math.round(AppState.brush-radius * 10) / 10; }
    }
    FormRow {
        label: "Strength";
        Slider {
            dialog: true;
            minimum: 1;
            maximum: 50;
            value: AppState.brush-strength;
            changed(v) => { AppState.brush-strength = v; }
        }
        Label { dialog: true; width: 50px; text: Math.round(AppState.brush-strength); }
    }
    FormRow {
        label: "Change";
        Check { dialog: true; text: "Raise"; checked: AppState.brush-raise; toggled => { AppState.brush-raise = true; } }
        Check { dialog: true; text: "Lower"; checked: !AppState.brush-raise; toggled => { AppState.brush-raise = false; } }
    }
    Tip {
        dialog: true;
        text: "Click or drag on the map. Each stroke is an edit that you can undo. The strokes apply after the template.";
    }
    Table {
        header: ["#", "Centre", "Radius", "Change"];
        widths: [26px, 110px, 54px, 54px];
        rows: Lists.brushes;
        list-height: 120px;
        pinned-action: "Remove";
        act(id) => { Actions.remove-brush(id); }
    }
}
