// The Notes Editor of FMG: the notes of the config, the notes (legends)
// of the regiments, the markers, and the zones of the shown world, and the
// text of the selected note. A new note goes into `world.notes`.

import { Theme, Field, FormRow, Label, Table, TextBox, Tip } from "../theme.slint";
import { Dialog } from "../dialog.slint";
import { AppState, Actions, Lists } from "../globals.slint";

export component NotesDialog inherits Dialog {
    id: "notes";
    title: "Notes Editor";
    content-width: 440px;
    pos-x: 460px;
    pos-y: 70px;
    Table {
        header: ["Type", "Name"];
        widths: [80px, 250px];
        rows: Lists.notes;
        action: "Remove";
        act(id) => { Actions.edit-item("notes", id, "remove", ""); }
        selected: AppState.selected-note;
        list-height: 180px;
        select(id) => {
            AppState.selected-note = id;
            Actions.selection-changed();
        }
    }
    TextBox {
        text: AppState.note-text;
        box-height: 160px;
    }
    FormRow {
        label: "New note";
        label-width: 90px;
        Field {
            dialog: true;
            horizontal-stretch: 1;
            placeholder: "Title of the note";
            accepted(t) => {
                Actions.edit-item("notes", "", "add", t);
                self.text = "";
            }
        }
    }
    Tip {
        dialog: true;
        text: "Notes: " + Lists.notes.length + ". Custom notes come from the config, and Remove takes one away. The world writes the other notes.";
    }
}
