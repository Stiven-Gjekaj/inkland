// The main window of the inkland desktop app. It has the look of Azgaar's
// Fantasy Map Generator: the map fills the window, the menu is at the top
// left, and the editors are dialogs over the map.

import { Theme } from "theme.slint";
import { AppState, Actions, Tool, Ui, Dialogs, Lists, Opts } from "globals.slint";
import { MapView } from "map-view.slint";
import { OptionsPanel } from "options-panel.slint";
import { StatusBar } from "status-bar.slint";
import { HeightmapDialog } from "dialogs/heightmap.slint";
import { BurgsDialog } from "dialogs/burgs.slint";
import { PrintDialog } from "dialogs/print.slint";
import { RegionsDialog } from "dialogs/regions.slint";
import { RiversDialog } from "dialogs/rivers.slint";
import { RoutesDialog } from "dialogs/routes.slint";
import { SubmapDialog } from "dialogs/submap.slint";
import { VariantsDialog } from "dialogs/variants.slint";
import { LabelsDialog } from "dialogs/labels.slint";
import { UnitsDialog } from "dialogs/units.slint";
import { SocietyDialog } from "dialogs/society.slint";
import { CellsDialog } from "dialogs/cells.slint";
import { EmblemsDialog } from "dialogs/emblems.slint";
import { DiplomacyDialog } from "dialogs/diplomacy.slint";
import { NotesDialog } from "dialogs/notes.slint";
import { MarkersDialog } from "dialogs/markers.slint";
import { MilitaryDialog } from "dialogs/military.slint";

export { AppState, Actions, Tool, Ui, Dialogs, Lists, Opts, Theme }

export component AppWindow inherits Window {
    in property <string> window-title: "inkland";
    title: root.window-title;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 800px;
    min-height: 520px;
    default-font-family: Theme.sans;
    default-font-size: Theme.font-size;

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open..."; activated => { Actions.open(); } }
            MenuItem { title: "Save"; activated => { Actions.save(); } }
            MenuItem { title: "Save As..."; activated => { Actions.save-as(); } }
            MenuItem { title: "Save Edit Script..."; activated => { Actions.save-script(); } }
            MenuSeparator {}
            MenuItem { title: "Quit"; activated => { Actions.quit(); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; enabled: AppState.can-undo; activated => { Actions.undo(); } }
            MenuItem { title: "Redo"; enabled: AppState.can-redo; activated => { Actions.redo(); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Show the Full Page"; activated => { Actions.fit(); } }
            MenuItem { title: "Show or Hide the Menu"; activated => { Ui.panel-open = !Ui.panel-open; } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "About inkland"; activated => { Ui.panel-open = true; Ui.tab = 4; } }
        }
    }

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if Actions.key(event.text, event.modifiers.control || event.modifiers.meta, event.modifiers.shift, event.modifiers.alt) {
                return accept;
            }
            reject
        }

        MapView {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
        }
        StatusBar {
            x: 0;
            y: root.height - self.height;
            width: root.width;
        }
        OptionsPanel {}
        if Dialogs.heightmap: HeightmapDialog {}
        if Dialogs.burgs: BurgsDialog {}
        if Dialogs.print: PrintDialog {}
        if Dialogs.regions: RegionsDialog {}
        if Dialogs.rivers: RiversDialog {}
        if Dialogs.routes: RoutesDialog {}
        if Dialogs.submap: SubmapDialog {}
        if Dialogs.variants: VariantsDialog {}
        if Dialogs.labels: LabelsDialog {}
        if Dialogs.units: UnitsDialog {}
        if Dialogs.cells: CellsDialog {}
        if Dialogs.emblems: EmblemsDialog {}
        if Dialogs.diplomacy: DiplomacyDialog {}
        if Dialogs.notes: NotesDialog {}
        if Dialogs.markers: MarkersDialog {}
        if Dialogs.military: MilitaryDialog {}
        if Dialogs.states: SocietyDialog {
            id: "states";
            title: "States Editor";
            pos-y: 60px;
            header: ["State", "Capital", "Culture", "Cells", "Burgs"];
            widths: [130px, 100px, 90px, 50px, 40px];
            rows: Lists.states;
        }
        if Dialogs.cultures: SocietyDialog {
            id: "cultures";
            title: "Cultures Editor";
            pos-y: 80px;
            header: ["Culture", "Cells", "Burgs"];
            widths: [200px, 60px, 60px];
            rows: Lists.cultures;
        }
        if Dialogs.religions: SocietyDialog {
            id: "religions";
            title: "Religions Editor";
            pos-y: 100px;
            header: ["Religion", "Type", "Culture", "Cells"];
            widths: [150px, 70px, 110px, 50px];
            rows: Lists.religions;
        }
        if Dialogs.provinces: SocietyDialog {
            id: "provinces";
            title: "Provinces Editor";
            pos-y: 120px;
            header: ["Province", "State", "Seat", "Cells"];
            widths: [140px, 110px, 100px, 50px];
            rows: Lists.provinces;
        }
    }

    public function focus-keys() {
        keys.focus();
    }
}
