// The state that the Rust code gives to the user interface, and the
// actions that the user interface sends to the Rust code.

import { TableRow } from "theme.slint";

export { TableRow }

// The tool of the map: select and move, add a point pin, the heightmap
// brush, draw a region, a river, a road, or a crop.
export enum Tool { select, add-pin, brush, region, river, route, crop }

// A point pin. `x` and `y` are its position in the map view.
export struct PinRow {
    id: string,
    label: string,
    x: length,
    y: length,
}

// A layer button: the FMG id, the text, the hotkey, and its state.
export struct LayerRow {
    id: string,
    label: string,
    key: string,
    on: bool,
    available: bool,
}

// A button of the Tools tab.
export struct ToolRow {
    id: string,
    label: string,
    hint: string,
    enabled: bool,
    active: bool,
}

export struct CheckRow {
    name: string,
    pass: bool,
    detail: string,
}

export global AppState {
    // The map image and where it goes in the map view.
    in property <image> map-image;
    in property <length> img-x;
    in property <length> img-y;
    in property <length> img-w;
    in property <length> img-h;
    in property <bool> generating;
    in property <bool> has-map;

    in property <[string]> variants;
    in-out property <int> variant-index;
    in property <[LayerRow]> layers;

    in-out property <Tool> tool: Tool.select;
    in property <[PinRow]> pins;
    in-out property <string> selected-id;
    in-out property <string> selected-name;
    // The kind (index in the kind list) and the port flag of the selected
    // pin.
    in property <int> selected-kind;
    in property <bool> selected-port;
    // A pin that the user drags: its position in the map view.
    in property <bool> dragging-pin;
    in property <length> drag-x;
    in property <length> drag-y;
    in-out property <int> new-pin-kind;

    // The brush: radius in config units, strength in height units.
    in-out property <float> brush-radius: 20;
    in property <float> brush-radius-max: 100;
    in-out property <float> brush-strength: 10;
    in-out property <bool> brush-raise: true;
    // The brush radius in the map view, and the pointer position.
    in property <length> brush-view-radius;
    in property <length> pointer-x;
    in property <length> pointer-y;
    in property <bool> pointer-in-map;

    // A new region: its shape (0 box, 1 circle, 2 polygon) and its kind
    // (an index in the region kinds).
    in-out property <int> region-shape;
    in-out property <int> region-kind: 3;
    // A new road: 0 road, 1 trail.
    in-out property <int> road-kind;
    // The marks over the map, as path commands in map view pixels: the
    // pins of the open editors, the selected pin, and the drawing.
    in property <string> overlay-path;
    in property <string> highlight-path;
    in property <string> draft-path;
    in property <[PinRow]> draft-points;

    in property <bool> can-undo;
    in property <bool> can-redo;

    in property <[CheckRow]> checks;
    in property <string> checks-summary;

    in property <string> status-position;
    in property <string> status-cell;
    in property <string> message;
    in property <bool> message-is-error;
    in property <string> file-name;
}

// The menu: open or closed, and the open tab.
export global Ui {
    in-out property <bool> panel-open: true;
    // 0 Layers, 1 Style, 2 Options, 3 Tools, 4 About.
    in-out property <int> tab: 0;
    // The top of the stack of the dialogs.
    in-out property <int> dialog-top: 10;
}

export global Actions {
    // Pointer events of the map view, in map view coordinates. `pan` is
    // true for the middle and the right button.
    callback pointer-down(length, length, bool);
    callback pointer-move(length, length);
    callback pointer-up(length, length);
    callback pointer-exit();
    callback scroll(length, length, length);
    callback viewport-changed(length, length);
    callback fit();
    callback brush-changed();

    callback select-variant(int);
    callback set-layer(string, bool);
    callback apply-preset(int);
    // An option of the Options tab or of the Style tab: the key and the
    // text of the field (see `options::OPTIONS`).
    callback set-option(string, string);
    // An entry of a select of the Options tab or of the Style tab.
    callback choose(string, int);
    // Make a new map with a new seed.
    callback new-map();
    // Remove the heightmap brush stroke with this row id.
    callback remove-brush(string);
    // The burgs editor: pin a generated place, and edit the selected pin.
    callback pin-place(string);
    callback set-pin-kind(int);
    callback set-pin-port(bool);
    // The drawing tools.
    callback start-tool(Tool);
    callback finish-draft();
    callback cancel-draft();
    // The selection of an editor table changed.
    callback selection-changed();
    // Edit a field of an item: the editor id, the item id, the field, and
    // the text.
    callback edit-item(string, string, string, string);
    callback remove-item(string, string);
    callback select-pin(string);
    callback rename-pin(string, string);
    callback remove-pin(string);
    callback undo();
    callback redo();

    callback open();
    callback save();
    callback save-as();
    callback save-script();
    callback quit();
    // A button of the Tools tab.
    callback open-tool(string);

    // The Rust code calls this from the event loop when a worker thread
    // has a result.
    callback poll();
}

// The lists that the menu shows.
export global Lists {
    // The tools of the groups Edit, Add, and Show, in this order.
    in property <[ToolRow]> tools;
    // The number of tools in each group.
    in property <[int]> tool-counts: [0, 0, 0];
    // The layer presets. The last entry is "Custom (not saved)".
    in property <[string]> presets;
    in property <[bool]> presets-disabled;
    in-out property <int> preset-index;
    // The rows of the editor tables.
    in property <[TableRow]> brushes;
    // The point pins, then the places that generation adds.
    in property <[TableRow]> burgs;
    in property <[TableRow]> regions;
    // The selected region and its fields.
    in-out property <string> selected-region;
    in-out property <string> region-name;
    in property <int> region-kind;
    in-out property <string> region-lo;
    in-out property <string> region-hi;
    in-out property <string> region-edge;
}

// The values of the Options tab and of the Style tab, as the text of their
// fields. The Rust code sets them from the config after each edit.
export global Opts {
    in-out property <string> seed;
    in-out property <string> width;
    in-out property <string> height;
    in-out property <string> cells;
    in-out property <string> cultures;
    in-out property <string> states;
    in-out property <string> towns;
    in-out property <string> religions;
    in-out property <string> sea-level;
    in-out property <string> lat-south;
    in-out property <string> lat-north;
    in-out property <string> units;
    in-out property <string> size-title;
    in-out property <string> size-state;
    in-out property <string> size-region;
    in-out property <string> size-city;
    in-out property <string> size-town;
    in-out property <string> size-village;
    in-out property <string> size-river;
    in-out property <string> size-other;
    in-out property <string> min-line;
    in-out property <string> grid-step;
    in-out property <string> title;
    in property <bool> scale-bar;
    in property <bool> compass;
    // The selects: the entries and the index of the value.
    in property <[string]> templates;
    in-out property <int> template;
    in property <[string]> culture-sets;
    in-out property <int> culture-set;
    in property <[string]> modes;
    in property <[bool]> modes-disabled;
    in-out property <int> mode;
    in property <[string]> styles;
    in property <[bool]> styles-disabled;
    in-out property <int> style;
    in property <[string]> fonts;
    in-out property <int> font-title;
    in-out property <int> font-labels;
    in-out property <int> font-labels-sc;
    in-out property <int> font-other;
}

// The open dialogs. `open` and `close` take the id of a dialog.
export global Dialogs {
    in-out property <bool> heightmap;
    in-out property <bool> burgs;
    in-out property <bool> regions;
    in-out property <bool> print;

    public function open(id: string) {
        if id == "heightmap" { self.heightmap = true; }
        if id == "burgs" { self.burgs = true; }
        if id == "regions" { self.regions = true; }
        Actions.selection-changed();
        if id == "print" { self.print = true; }
    }

    public function close(id: string) {
        if id == "heightmap" { self.heightmap = false; }
        if id == "burgs" { self.burgs = false; }
        if id == "regions" { self.regions = false; }
        Actions.selection-changed();
        if id == "print" { self.print = false; }
    }

    public function close-all() {
        self.heightmap = false;
        self.burgs = false;
        self.regions = false;
        Actions.selection-changed();
        self.print = false;
    }
}
